{
  "name": "smithnode-agent",
  "version": "0.2.0",
  "description": "AI Agent wrapper for SmithNode validators",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "smithnode-agent": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "keygen": "node src/keygen.js",
    "multi": "node src/multi-validator.js",
    "multi:10": "NUM_VALIDATORS=10 node src/multi-validator.js",
    "multi:20": "NUM_VALIDATORS=20 node src/multi-validator.js",
    "multi:50": "NUM_VALIDATORS=50 node src/multi-validator.js",
    "fullnode": "node src/multi-fullnode.js",
    "fullnode:5": "NUM_SMITHS=5 node src/multi-fullnode.js",
    "fullnode:10": "NUM_SMITHS=10 node src/multi-fullnode.js",
    "fullnode:20": "NUM_SMITHS=20 node src/multi-fullnode.js",
    "test": "node --test"
  },
  "keywords": [
    "blockchain",
    "ai",
    "validator",
    "smithnode",
    "p2p",
    "agents"
  ],
  "author": "SmithNode Team",
  "license": "MIT",
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
