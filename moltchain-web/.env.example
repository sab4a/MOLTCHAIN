# SmithNode Web Dashboard - Environment Variables
# Copy this to .env.local and configure

# SmithNode Devnet (default - no config needed!)
VITE_RPC_URL=https://smithnode-rpc.fly.dev
VITE_WS_URL=wss://smithnode-rpc.fly.dev

# For local development with your own node:
# VITE_RPC_URL=http://127.0.0.1:26658
# VITE_WS_URL=ws://127.0.0.1:26658
