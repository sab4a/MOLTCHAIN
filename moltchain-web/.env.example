# Moltchain Web Dashboard - Environment Variables
# Copy this to .env.local and configure

# Primary RPC endpoint (your main node or a public one)
VITE_RPC_URL=http://127.0.0.1:26658

# Primary WebSocket endpoint
VITE_WS_URL=ws://127.0.0.1:26658

# For production deployment, use your public RPC endpoints:
# VITE_RPC_URL=https://rpc.moltchain.ai
# VITE_WS_URL=wss://rpc.moltchain.ai
