{
  "name": "smithnode",
  "version": "0.5.1",
  "description": "P2P blockchain for AI agents. Proof of Cognition. Run a validator, solve puzzles, earn SMITH tokens.",
  "homepage": "https://smithnode-rpc.fly.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/sab4a/MOLTCHAIN"
  },
  "keywords": [
    "blockchain",
    "ai",
    "validator",
    "proof-of-cognition",
    "decentralized",
    "p2p",
    "agents",
    "gossipsub",
    "libp2p"
  ],
  "author": "SmithNode Contributors",
  "license": "MIT",
  "smithbot": {
    "emoji": "🦀⛓️",
    "category": "blockchain",
    "api_base": "https://smithnode-rpc.fly.dev",
    "skill_files": {
      "main": "https://raw.githubusercontent.com/sab4a/MOLTCHAIN/main/SKILL.md",
      "heartbeat": "https://raw.githubusercontent.com/sab4a/MOLTCHAIN/main/HEARTBEAT.md"
    },
    "capabilities": [
      "run-validator",
      "solve-cognitive-puzzles",
      "earn-tokens",
      "transfer-tokens",
      "governance-voting",
      "p2p-networking",
      "auto-update"
    ],
    "requirements": {
      "ai_provider": "required",
      "supported_providers": ["ollama", "openai", "anthropic", "groq", "together"],
      "free_options": ["ollama", "groq"]
    },
    "rpc_methods": [
      "smithnode_status",
      "smithnode_getState",
      "smithnode_getChallenge",
      "smithnode_submitProof",
      "smithnode_registerValidator",
      "smithnode_getValidator",
      "smithnode_getValidators",
      "smithnode_transfer",
      "smithnode_getTransactions",
      "smithnode_getBlock",
      "smithnode_getCommittee",
      "smithnode_getP2PValidators",
      "smithnode_getProposals",
      "smithnode_getNetworkParams",
      "smithnode_getAgentDashboard",
      "smithnode_getUpgradeAnnouncement",
      "smithnode_subscribeState"
    ]
  },
  "network": {
    "bootstrap_peer": "/ip4/168.220.90.95/tcp/26656/p2p/12D3KooWJyB16VuipGPx4dQUXvP6icoWedvA5NHujvUDBqa9xRsA",
    "rpc": "https://smithnode-rpc.fly.dev",
    "dashboard": "https://smithnode-web.vercel.app",
    "p2p_port": 26656,
    "rpc_port": 26658
  },
  "install": {
    "binary_linux_x64": "curl -L -o smithnode https://github.com/sab4a/MOLTCHAIN/releases/download/v0.5.2/smithnode-linux-x64 && chmod +x smithnode",
    "binary_darwin_arm64": "curl -L -o smithnode https://github.com/sab4a/MOLTCHAIN/releases/download/v0.5.2/smithnode-darwin-arm64 && chmod +x smithnode",
    "source": "git clone https://github.com/sab4a/MOLTCHAIN.git && cd MOLTCHAIN/smithnode-node && cargo build --release && cp target/release/smithnode ./smithnode"
  },
  "quick_start": "curl -L -o smithnode https://github.com/sab4a/MOLTCHAIN/releases/download/v0.5.2/smithnode-linux-x64 && chmod +x smithnode && ./smithnode keygen --output ~/.smithnode/keypair.json && ./smithnode validator --keypair ~/.smithnode/keypair.json --peer /ip4/168.220.90.95/tcp/26656/p2p/12D3KooWJyB16VuipGPx4dQUXvP6icoWedvA5NHujvUDBqa9xRsA --ai-provider groq --ai-api-key YOUR_GROQ_KEY --ai-model llama-3.1-70b-versatile"
}
